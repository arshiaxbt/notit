# Contracts are listed in src/deployments.json (committed). These build-time
# variables are optional overrides.

# A single contract to use instead of the list in deployments.json.
VITE_CONTRACT_ID=
# Put this RPC endpoint first.
VITE_RPC_URL=
# testnet (default) or mainnet.
VITE_NETWORK=testnet
# Poll interval for Testnet mode, in milliseconds (default 3000).
VITE_POLL_MS=3000

# With no contract at all (empty list and no VITE_CONTRACT_ID) the app runs in
# Demo mode only and makes no network requests. `?mode=demo` in the address
# opens Demo mode even when a contract is configured.
